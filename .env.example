# ---- LLM provider for the intake agent ----
# Which backend to use. Leave unset for Gemini, or pick a free alternative:
#   openrouter (best free — DeepSeek/Llama/Qwen), groq (free + fast), glm.
# Just set this and add the matching key below, then restart.
LLM_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-key-here
# Free key from https://openrouter.ai/keys (models tagged ":free" cost nothing)
OPENROUTER_API_KEY=
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Free GLM-4-Flash key from https://open.bigmodel.cn
GLM_API_KEY=
# DeepSeek direct (paid, cheap) from https://platform.deepseek.com
DEEPSEEK_API_KEY=

ADMIN_PASSWORD=change-me

# Personal bKash number shown to supporters for manual Send Money treats.
# Leave empty to hide the payment instructions (tiers show "coming soon").
BKASH_NUMBER=

# Base URL of the deployed app (used for Google OAuth redirects)
APP_URL=http://localhost:3000

# Optional — Google sign-in. Create a free OAuth "Web application" client at
# console.cloud.google.com → APIs & Services → Credentials, with authorized
# redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
